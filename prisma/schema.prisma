datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  isAdmin       Boolean   @default(false)
  isBusiness     Boolean @default(false)
  businessNumber String?
  companyName    String?
  website        String?
  dateOfBirth        DateTime?
  gender             String?
  addressStreet      String?
  addressCity        String?
  addressProvince    String?
  addressPostalCode  String?
  phone              String?
  termsAcceptedAt    DateTime?

  notifyProductUpdates Boolean @default(true)
  notifyBillingAlerts  Boolean @default(true)

  apiKeys ApiKey[]

  plan         Plan     @default(FREE)
  monthlyUsage Int      @default(0)
  usageResetAt DateTime @default(now())

  accountType AccountType @default(CREATOR)

  accounts           Account[]
  sessions           Session[]
  subscription       Subscription?
  generations        Generation[]
  projects           Project[]
  entitlement        UserEntitlement?
  creditsBalance     Int                      @default(0)
  creditTransactions CreditTransaction[]
  supportMessages    SupportMessage[]
  connectAccount     ConnectAccount?
  repairJobs         RepairJob[]

  sellerProfile      MarketplaceSeller?
  marketplaceOrders  MarketplaceOrder[]  @relation("MarketplaceBuyerOrders")
  marketplaceReviews MarketplaceReview[] @relation("MarketplaceBuyerReviews")

  identityDocuments     IdentityDocument[]
  identityVerifications IdentityVerification[]
  identityAuditEvents   IdentityAuditEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum IdentityDocumentType {
  DRIVERS_LICENSE
  PASSPORT
  GOVERNMENT_ID
  HEALTH_INSURANCE_CARD
  BIRTH_CERTIFICATE
}

// Statut du document lui-meme (distinct du statut de verification global,
// voir IdentityStatus). Un document EXPIRED reste une preuve d'identite
// valable - voir IdentityStatus.VERIFIED_EXPIRED_DOCUMENT.
enum DocumentAnalysisStatus {
  VALID
  EXPIRED
  QUALITY_ISSUE
  SUSPECTED_FAKE
  UNREADABLE
}

model IdentityDocument {
  id         String               @id @default(cuid())
  userId     String
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       IdentityDocumentType
  fileName   String
  mimeType   String
  // Chiffre au repos (AES-256-GCM, voir src/lib/identity/security/encryption.ts).
  fileData   Bytes
  reviewed   Boolean              @default(false)
  uploadedAt DateTime             @default(now())
  // Purge configurable de l'image source apres traitement (voir
  // scripts/purge-identity-document-images.mjs) - fileData est alors vide,
  // seules les metadonnees extraites subsistent.
  purgedAt   DateTime?

  documentStatus DocumentAnalysisStatus?
  expired        Boolean                 @default(false)
  issuedDate     DateTime?
  expirationDate DateTime?
  documentNumber String?
  countryCode    String?
  region         String?
  ocrConfidence  Int?

  // Signaux extraits automatiquement (best-effort, non garantis) : hashs
  // perceptuels pour la detection de doublons, nom/DOB pour la coherence
  // croisee, score de qualite d'image.
  dHash         String?
  pHash         String?
  extractedName String?
  extractedDob  DateTime?
  qualityScore  Int?

  @@unique([userId, type])
  @@index([userId])
}

// Niveau de verification d'identite global. L'expiration d'un document ne
// produit JAMAIS REJECTED a elle seule - voir VERIFIED_EXPIRED_DOCUMENT.
// REJECTED n'est utilise que pour un document illisible, manifestement
// falsifie, ou des informations incompatibles.
enum IdentityStatus {
  VERIFIED
  VERIFIED_EXPIRED_DOCUMENT
  NEEDS_REVIEW
  REJECTED
}

model IdentityVerification {
  id                    String         @id @default(cuid())
  userId                String
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  identityStatus        IdentityStatus
  identityEvidenceScore Int
  expired               Boolean        @default(false)
  reviewRequired        Boolean        @default(false)
  // Liste de signaux {type, points, message} - voir src/lib/identity/types.ts
  signals               Json
  // Renseigne uniquement lors d'une decision manuelle (ex: REJECTED
  // confirme par un admin) - le moteur automatique ne l'ecrit jamais pour
  // ce statut.
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([identityStatus])
}

// Journal d'audit des evenements de verification, sans jamais exposer le
// contenu des documents (voir src/lib/identity/identityAudit.ts).
enum IdentityAuditEventType {
  DOCUMENT_UPLOADED
  DOCUMENT_ANALYZED
  VERIFICATION_COMPLETED
  ADMIN_DECISION
  DOCUMENT_PURGED
  UPLOAD_REJECTED_SECURITY
}

model IdentityAuditEvent {
  id        String                 @id @default(cuid())
  userId    String
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      IdentityAuditEventType
  // Details factuels (type de document, statut resultant, etc.) - jamais
  // le contenu du fichier ni le texte OCR brut.
  metadata  Json?
  createdAt DateTime               @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  planId               String?
  status               String    @default("inactive")
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  discountId           String?

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan? @relation(fields: [planId], references: [id])
  discount Discount?         @relation(fields: [discountId], references: [id])

  usageLimits UsageLimit[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  generations Generation[]

  @@index([status])
}

enum PlanTier {
  WEEKLY_PRO
  MONTHLY_PRO
  ANNUAL_PRO
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  TRIALING
}

model SubscriptionPlan {
  id               String   @id @default(cuid())
  name             String   @unique
  internalName     String   @unique
  tier             PlanTier
  currency         String   @default("CAD")
  generationsLimit Int
  stripeProductId  String?
  features         Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subscriptions Subscription[]
  prices        PlanPrice[]
}

model UsageLimit {
  id              String   @id @default(cuid())
  subscriptionId  String
  periodStart     DateTime
  periodEnd       DateTime
  generationsUsed Int      @default(0)
  generationsCap  Int

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subscriptionId, periodStart])
}

model Generation {
  id             String   @id @default(cuid())
  userId         String
  subscriptionId String?
  projectId      String?
  prompt         String   @db.Text
  status         String   @default("completed")
  metadata       Json?
  createdAt      DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([projectId])
}

model GenerationJob {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  prompt    String   @db.Text
  status    String   @default("pending")
  result    Json?
  error     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model Project {
  id             String   @id @default(cuid())
  userId         String
  name           String
  projectPath    String   @unique
  currentVersion Int      @default(1)
  preferences    Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  generations         Generation[]
  versions            ProjectVersion[]
  repairJobs          RepairJob[]
  marketplaceProducts MarketplaceProduct[]
  agencyOffers        AgencyOffer[]

  @@index([userId])
}

model ProjectVersion {
  id            String   @id @default(cuid())
  projectId     String
  versionNumber Int
  prompt        String   @db.Text
  blueprint     Json?
  createdAt     DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, versionNumber])
  @@index([projectId])
}

model Discount {
  id             String   @id @default(cuid())
  code           String   @unique
  percentOff     Int
  appliesToTier  PlanTier
  validFrom      DateTime
  validUntil     DateTime
  stripeCouponId String?
  createdAt      DateTime @default(now())

  subscriptions Subscription[]

  @@index([validFrom, validUntil])
}

model UserEntitlement {
  id        String   @id @default(cuid())
  userId    String   @unique
  features  Json
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  keyPrefix  String
  keyHash    String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum CreditTransactionType {
  PURCHASE
  CONSUMPTION
  REFUND
}

model CreditPack {
  id            String  @id @default(cuid())
  name          String  @unique
  priceCents    Int
  currency      String  @default("CAD")
  credits       Int
  stripePriceId String?
  active        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CreditTransaction {
  id                    String                @id @default(cuid())
  userId                String
  type                  CreditTransactionType
  amount                Int
  balanceAfter          Int
  stripePaymentIntentId String?               @unique
  generationId          String?
  createdAt             DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PlanPrice {
  id              String           @id @default(uuid())
  planId          String
  plan            SubscriptionPlan @relation(fields: [planId], references: [id])
  billingInterval String
  priceCents      Int
  stripePriceId   String           @unique
  isDefault       Boolean          @default(false)
  createdAt       DateTime         @default(now())
}

model SupportMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String
  content   String   @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

enum AccountType {
  CREATOR
  AGENCY
}

model ConnectAccount {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeConnectAccountId String   @unique
  onboardingComplete     Boolean  @default(false)
  payoutsEnabled         Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

enum RepairJobStatus {
  PENDING_PAYMENT
  PAID
  QUEUED
  ANALYZING
  FIXING
  VALIDATING
  COMPLETED
  FAILED
  CANCELLED
}

enum RepairValidationStatus {
  PENDING
  OK
  FAILED
}

model RepairJob {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String? @unique

  status RepairJobStatus @default(PENDING_PAYMENT)

  price    Int    @default(2999)
  currency String @default("CAD")

  attempts         Int                    @default(0)
  errorsDetected   Int?
  errorsFixed      Int?
  validationStatus RepairValidationStatus @default(PENDING)

  fixedFilesSummary Json?
  remainingErrors   Json?
  failureReason     String? @db.Text

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([projectId])
  @@index([status])
}

enum SellerTier {
  STANDARD
  PRO
  ENTERPRISE
}

enum MarketplaceProductType {
  PLUGIN
  TEMPLATE
  APPLICATION
  COMPONENT
  AI_AGENT
  DEV_TOOL
  PROJECT
  SERVICE
  DIGITAL_RESOURCE
}

enum MarketplaceProductStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  ARCHIVED
}

enum MarketplaceOrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum SponsoredPlacementType {
  HOUR_24
  DAYS_7
  DAYS_30
  FEATURED
  HOMEPAGE
}

enum SponsoredPlacementStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELLED
}

enum SellerPayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum MarketplaceAnalyticsEventType {
  VIEW
  CLICK
  SALE
  SPONSORED_IMPRESSION
  SPONSORED_CLICK
}

model MarketplaceCommissionConfig {
  id        String     @id @default(cuid())
  tier      SellerTier @unique
  rate      Float
  active    Boolean    @default(true)
  updatedAt DateTime   @updatedAt
}

model MarketplaceSponsoredPrice {
  id            String                 @id @default(cuid())
  placementType SponsoredPlacementType @unique
  priceCents    Int
  currency      String                 @default("CAD")
  active        Boolean                @default(true)
  updatedAt     DateTime               @updatedAt
}

model MarketplaceCategory {
  id        String               @id @default(cuid())
  name      String               @unique
  slug      String               @unique
  createdAt DateTime             @default(now())
  products  MarketplaceProduct[]
}

model MarketplaceSeller {
  id           String     @id @default(cuid())
  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier         SellerTier @default(STANDARD)
  displayName  String?
  bio          String?    @db.Text
  suspended    Boolean    @default(false)
  isBuyingAgency Boolean  @default(false)
  stripeCustomerId       String?
  defaultPaymentMethodId String?
  balanceCents Int        @default(0)
  ratingAvg    Float      @default(0)
  ratingCount  Int        @default(0)

  products   MarketplaceProduct[]
  orders     MarketplaceOrder[]
  payouts    SellerPayout[]
  placements SponsoredPlacement[]
  agencyOffersMade AgencyOffer[] @relation("AgencyOffersMade")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tier])
}

model MarketplaceProduct {
  id         String               @id @default(cuid())
  sellerId   String
  seller     MarketplaceSeller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId String?
  category   MarketplaceCategory? @relation(fields: [categoryId], references: [id])
  projectId  String?
  project    Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)

  type        MarketplaceProductType
  title       String
  slug        String                   @unique
  description String                   @db.Text
  priceCents  Int
  currency    String                   @default("CAD")
  status      MarketplaceProductStatus @default(DRAFT)

  version       String?
  changelog     String? @db.Text
  techStack     Json?
  compatibility String?
  licenseType   String?
  screenshots   Json?

  salesCount  Int   @default(0)
  viewCount   Int   @default(0)
  ratingAvg   Float @default(0)
  ratingCount Int   @default(0)

  orders     MarketplaceOrder[]
  reviews    MarketplaceReview[]
  placements SponsoredPlacement[]
  events     MarketplaceAnalyticsEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
  @@index([type])
}

model MarketplaceOrder {
  id        String             @id @default(cuid())
  productId String
  product   MarketplaceProduct @relation(fields: [productId], references: [id])
  buyerId   String
  buyer     User               @relation("MarketplaceBuyerOrders", fields: [buyerId], references: [id])
  sellerId  String
  seller    MarketplaceSeller  @relation(fields: [sellerId], references: [id])

  priceCents        Int
  currency          String @default("CAD")
  commissionRate    Float
  commissionCents   Int
  sellerAmountCents Int

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String? @unique

  status    MarketplaceOrderStatus @default(PENDING)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  review MarketplaceReview?

  @@index([buyerId])
  @@index([sellerId])
  @@index([productId])
  @@index([status])
}

model MarketplaceReview {
  id        String             @id @default(cuid())
  orderId   String             @unique
  order     MarketplaceOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   MarketplaceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User               @relation("MarketplaceBuyerReviews", fields: [buyerId], references: [id])
  rating    Int
  comment   String?            @db.Text
  createdAt DateTime           @default(now())

  @@index([productId])
}

model SponsoredPlacement {
  id        String             @id @default(cuid())
  productId String
  product   MarketplaceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    MarketplaceSeller  @relation(fields: [sellerId], references: [id])

  placementType SponsoredPlacementType
  priceCents    Int
  currency      String                 @default("CAD")

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String? @unique

  status    SponsoredPlacementStatus @default(PENDING_PAYMENT)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  events MarketplaceAnalyticsEvent[]

  @@index([productId])
  @@index([status])
  @@index([endsAt])
}

model SellerPayout {
  id       String            @id @default(cuid())
  sellerId String
  seller   MarketplaceSeller @relation(fields: [sellerId], references: [id])

  amountCents      Int
  currency         String             @default("CAD")
  status           SellerPayoutStatus @default(PENDING)
  stripeTransferId String?            @unique

  requestedAt DateTime  @default(now())
  paidAt      DateTime?

  @@index([sellerId])
  @@index([status])
}

enum AgencyOfferType {
  PROJECT_PURCHASE
  CONTACT_RIGHT
}

enum AgencyOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  PAID
  PAYMENT_FAILED
}

model AgencyOffer {
  id        String @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  agencySellerId String
  agencySeller   MarketplaceSeller @relation("AgencyOffersMade", fields: [agencySellerId], references: [id], onDelete: Cascade)

  type            AgencyOfferType
  priceCents      Int
  currency        String            @default("CAD")
  message         String?           @db.Text
  status          AgencyOfferStatus @default(PENDING)
  commissionCents Int

  createdAt  DateTime  @default(now())
  respondedAt DateTime?
  stripePaymentIntentId String?
  paidAt DateTime?

  signedAt      DateTime?
  signatureText String?
  termsVersion  String?

  @@index([projectId])
  @@index([agencySellerId])
  @@index([status])
}


model MarketplaceAnalyticsEvent {
  id                   String                        @id @default(cuid())
  productId            String
  product              MarketplaceProduct            @relation(fields: [productId], references: [id], onDelete: Cascade)
  sponsoredPlacementId String?
  sponsoredPlacement   SponsoredPlacement?            @relation(fields: [sponsoredPlacementId], references: [id], onDelete: SetNull)
  type                 MarketplaceAnalyticsEventType
  createdAt            DateTime                       @default(now())

  @@index([productId, type])
  @@index([sponsoredPlacementId])
}
